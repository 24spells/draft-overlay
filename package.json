{
  "name": "mtg-draft-overlay",
  "productName": "Draft Overlay",
  "version": "0.3.9",
  "private": true,
  "description": "MTG Arena draft overlay showing 17Lands public stats on each card.",
  "license": "MIT",
  "type": "module",
  "main": "app/main.mjs",
  "scripts": {
    "build": "node scripts/build-app.mjs",
    "start": "node scripts/build-app.mjs && electron .",
    "preview": "node sim/serve.mjs",
    "test": "node --disable-warning=ExperimentalWarning --test core-tests/core.test.ts",
    "dist": "node scripts/build-app.mjs && electron-builder --win nsis",
    "release": "node scripts/release.mjs",
    "icons": "node scripts/make-icons.mjs"
  },
  "build": {
    "appId": "com.draftoverlay.app",
    "productName": "Draft Overlay",
    "artifactName": "Draft-Overlay-Setup.${ext}",
    "directories": {
      "output": "dist"
    },
    "asar": false,
    "files": [
      "package.json",
      "app/**",
      "scripts/build-stats.mjs",
      "LICENSE"
    ],
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false,
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "shortcutName": "Draft Overlay"
    }
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "^26.0.12"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
